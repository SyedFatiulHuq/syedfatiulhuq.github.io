---
import site from '../data/site.json';
const { title = site.name } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={site.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${site.name}, ${site.title}, ${site.affiliation}`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header>
      <nav aria-label="Main">
        <a href="#about">About</a>
        <a href="#research">Research</a>
        <a href="#publications">Publications</a>
        <a href="#teaching">Teaching</a>
        <a href="#more">Awards &amp; Service</a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer>© {new Date().getFullYear()} {site.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fdfdfc; --fg: #1d1d1f; --muted: #5f6368; --rule: #e3e3e0;
    --accent: #556b2f; --accent-soft: #f1f4e8;
  }
  /* Accent presets: set "theme" in src/data/site.json. All pass 4.5:1 contrast on --bg. */
  :root[data-theme="olive"] { --accent: #556b2f; --accent-soft: #f1f4e8; }
  :root[data-theme="sage"]  { --accent: #4f6f52; --accent-soft: #eef3ee; }
  :root[data-theme="blue"]  { --accent: #1a5fb4; --accent-soft: #eef3fb; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 4rem; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 17px/1.6 Georgia, "Times New Roman", serif;
  }
  header, main, footer { max-width: 44rem; margin: 0 auto; padding: 0 1rem; }
  main:focus { outline: none; }
  header { position: sticky; top: 0; z-index: 5; background: var(--bg); display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-top: .9rem; padding-bottom: .9rem; border-bottom: 1px solid var(--rule); font-family: system-ui, sans-serif; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
  nav a { color: var(--muted); text-decoration: none; padding: .25rem 0; }
  nav a:hover { color: var(--accent); text-decoration: underline; }
  a { color: var(--accent); }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 3px; }

  .skip { position: absolute; left: -999px; top: 0; background: var(--fg); color: var(--bg); padding: .6rem 1rem; z-index: 10; font-family: system-ui, sans-serif; }
  .skip:focus { left: 0; }

  section { padding: 1.5rem 0 .5rem; }
  h1, h2 { font-family: system-ui, sans-serif; line-height: 1.2; }
  h1 { font-size: 2rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.15rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); border-bottom: 1px solid var(--rule); padding-bottom: .3rem; }
  h3 { font: 600 1rem system-ui, sans-serif; margin: 1.25rem 0 .5rem; }
  .muted, .sub { color: var(--muted); }
  .sub { margin: 0 0 1rem; }

  .hero { display: flex; gap: 1.75rem; align-items: center; }
  .photo { width: 200px; height: 267px; object-fit: cover; border-radius: 8px; flex: none; }
  .hero-text { min-width: 0; }
  .icons { display: flex; gap: .5rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .icons a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--rule); border-radius: 50%; color: var(--fg); }
  .icons a:hover { border-color: var(--accent); color: var(--accent); }
  .icons svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .docs { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .btn { display: inline-block; font: .9rem system-ui, sans-serif; text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; padding: .5rem .9rem; }
  .btn:hover { background: var(--accent); color: var(--bg); }
  @media (max-width: 36rem) {
    .hero { flex-direction: column; align-items: flex-start; }
    .photo { width: 160px; height: 213px; }
  }

  ul.plain { list-style: none; padding: 0; }
  ul.plain li { margin-bottom: 1rem; }
  ul.compact li { margin-bottom: .35rem; }
  .year { display: inline-block; min-width: 4.5rem; color: var(--muted); font-family: system-ui, sans-serif; font-size: .9rem; }
  .tag { font: .8rem system-ui, sans-serif; color: var(--muted); border: 1px solid var(--rule); border-radius: 99px; padding: .05rem .5rem; margin-left: .4rem; white-space: nowrap; }
  ul.plain li.featured { border-left: 4px solid var(--accent); background: var(--accent-soft); padding: .6rem .8rem; border-radius: 0 6px 6px 0; }
  ul.plain li.featured::before { content: 'Selected'; display: block; font: 600 .75rem system-ui, sans-serif; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); margin-bottom: .2rem; }
  .tag.award { color: #6b4200; background: #fff1cc; border-color: #c98a00; }
  .tag.link { text-decoration: none; color: var(--accent); border-color: var(--accent); display: inline-block; padding: .2rem .6rem; }
  .tag.link:hover { background: var(--accent); color: var(--bg); }
  footer { color: var(--muted); font: .85rem system-ui, sans-serif; padding-top: 2rem; padding-bottom: 2rem; }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (forced-colors: active) {
    .icons a, .btn, .tag { border-color: LinkText; }
  }
</style>
